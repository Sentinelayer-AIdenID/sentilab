{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentilab.invalid/open-proposal/v1/current.schema.json",
  "title": "sentilab-open-current/1",
  "description": "/sentilab/open/manifest/<problem>/current.json: names the open manifest version and where to submit. The threads live here, not in the manifest, because each root message carries the manifest id and overflow rooms open during the event.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "problem", "version", "manifest_id", "threads"],
  "properties": {
    "schema": {"const": "sentilab-open-current/1"},
    "problem": {"$ref": "common.schema.json#/$defs/id"},
    "version": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "manifest_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "threads": {"type": "array", "maxItems": 16,
                "items": {"type": "object", "additionalProperties": false, "required": ["room", "root_sequence"],
                          "properties": {"room": {"$ref": "common.schema.json#/$defs/uuid"},
                                         "root_sequence": {"type": "integer", "minimum": 1,
                                                           "maximum": 9007199254740991}}}}
  }
}
