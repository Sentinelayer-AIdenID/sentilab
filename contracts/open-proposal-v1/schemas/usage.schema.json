{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentilab.invalid/open-proposal/v1/usage.schema.json",
  "title": "sentilab-open-usage/1",
  "description": "One settled native call in the single global usage journal. Every call of an evaluate, replay or grid bundle, every route and every lifecycle overhead is its own record under its own suballocation. Reserved before launch (reserved = enforced + cleanup headroom), settled on every exit: an unmeasured call debits its full reservation, and an interrupted call is unmeasured. Two separate things are recorded: live enforcement (enforcement: whether the process was stopped in flight at enforced_cpu_s) and settlement-time overrun detection (overrun: whether the measured CPU exceeded the reservation, found after the fact). A detected overrun was not prevented; it only stops new reservations. payer is whose budget is debited; a check is the sponsor's, and it still spends sponsor CPU.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "journal_seq", "suballocation", "payer", "run_id", "participant_ref", "proposal_sha256", "call",
               "reservation_id", "reserved_cpu_s", "enforced_cpu_s", "cleanup_headroom_cpu_s", "debited_cpu_s",
               "measured_cpu_s", "elapsed_s", "enforcement", "overrun", "outcome", "codes"],
  "properties": {
    "schema": {"const": "sentilab-open-usage/1"},
    "journal_seq": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "suballocation": {"enum": ["evaluate", "replay", "grid", "route", "lifecycle", "check"]},
    "payer": {"enum": ["participant", "sponsor"]},
    "run_id": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/run_id"}]},
    "participant_ref": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/participant_ref"}]},
    "proposal_sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
    "call": {"type": "integer", "minimum": 0, "maximum": 1000},
    "reservation_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "reserved_cpu_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000},
    "enforced_cpu_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000000},
    "cleanup_headroom_cpu_s": {"$ref": "common.schema.json#/$defs/seconds"},
    "debited_cpu_s": {"$ref": "common.schema.json#/$defs/seconds"},
    "measured_cpu_s": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000},
    "elapsed_s": {"type": ["number", "null"], "minimum": 0, "maximum": 1000000},
    "enforcement": {"description": "Live enforcement while the call ran.", "enum": ["not_triggered", "stopped_in_flight"]},
    "overrun": {"description": "Overrun detection at settlement, after the fact: never prevention.",
                "enum": ["none", "detected", "unmeasured"]},
    "outcome": {"enum": ["settled", "failed", "interrupted"]},
    "codes": {"$ref": "common.schema.json#/$defs/violations"}
  },
  "if": {"properties": {"suballocation": {"const": "check"}}},
  "then": {"properties": {"run_id": {"type": "null"}, "payer": {"const": "sponsor"}}},
  "else": {"properties": {"run_id": {"type": "string"}, "participant_ref": {"type": "string"},
                          "proposal_sha256": {"type": "string"}}}
}
