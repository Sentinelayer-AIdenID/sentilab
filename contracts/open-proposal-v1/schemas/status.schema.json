{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentilab.invalid/open-proposal/v1/status.schema.json",
  "title": "sentilab-open-status/1",
  "description": "GET /api/open/v1/status?proposal_sha256=<...> (DESIGN rev 3 section 10), in exactly the example's shape. The query is the salted proposal_sha256: for a private entry the only unauthenticated way in, a bearer secret that never appears in a public record or pointer. run_id = open-<manifest_id 8 hex>-<proposal_sha256 16 hex>. queue is set only while the entry is queued. The codes are in the receipt named by receipt_hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipts"],
  "properties": {
    "schema": {"const": "sentilab-open-status/1"},
    "receipts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participant_ref", "actor_kind", "state", "queue", "receipt_hash", "run_id"],
        "properties": {
          "participant_ref": {"$ref": "common.schema.json#/$defs/participant_ref"},
          "actor_kind": {"$ref": "common.schema.json#/$defs/actor_kind"},
          "state": {"$ref": "common.schema.json#/$defs/lifecycle_state"},
          "queue": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["position", "estimated_start"],
            "properties": {
              "position": {"type": "integer", "minimum": 1, "maximum": 1000000},
              "estimated_start": {"$ref": "common.schema.json#/$defs/utc_or_null"}
            }
          },
          "receipt_hash": {"$ref": "common.schema.json#/$defs/sha256"},
          "run_id": {"$ref": "common.schema.json#/$defs/run_id"}
        }
      }
    }
  }
}
