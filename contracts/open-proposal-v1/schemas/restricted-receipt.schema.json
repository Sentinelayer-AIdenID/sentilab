{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentilab.invalid/open-proposal/v1/restricted-receipt.schema.json",
  "title": "sentilab-open-restricted-receipt/1",
  "description": "The restricted ledger record behind a public receipt: the only record that carries the participant's immutable account id (Senti's server-set actorUserId) and the intake's own identity. Authority comes from actor_user_id, never from a label: there is no label field. actor_kind is what Senti stamped (human for a bare account token, agent for an admitted agent); quotas bind to actor_user_id either way. It opens the public commitments: participant_ref, source_ref and transport_id are recomputable from it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "participant_ref", "actor_user_id", "actor_kind", "actor_agent_id", "intake", "room",
               "action_id", "created_at", "target_sequence", "message_revision", "source_ref", "body_sha256",
               "manifest_id", "proposal_key", "proposal_sha256", "transport_id", "sealed", "capability_sha256",
               "capability_epoch", "capability_revoked"],
  "properties": {
    "schema": {"const": "sentilab-open-restricted-receipt/1"},
    "participant_ref": {"$ref": "common.schema.json#/$defs/participant_ref"},
    "actor_user_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "actor_kind": {"enum": ["human", "agent"]},
    "actor_agent_id": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/agent_id"}]},
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "agent_id"],
      "properties": {
        "account_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "agent_id": {"$ref": "common.schema.json#/$defs/agent_id"}
      }
    },
    "room": {"$ref": "common.schema.json#/$defs/uuid"},
    "action_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "created_at": {"$ref": "common.schema.json#/$defs/senti_time"},
    "target_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "message_revision": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "source_ref": {"$ref": "common.schema.json#/$defs/sha256"},
    "body_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "manifest_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "proposal_key": {"$ref": "common.schema.json#/$defs/id_or_null"},
    "proposal_sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
    "transport_id": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/transport_id"}]},
    "sealed": {"type": "boolean"},
    "capability_sha256": {"description": "sha256 of the current epoch's bearer capability, to look it up; never the capability.",
                          "$ref": "common.schema.json#/$defs/sha256_or_null"},
    "capability_epoch": {"description": "The capability's epoch: rotation derives a new capability at the next epoch.",
                         "type": ["integer", "null"], "minimum": 1, "maximum": 1000000},
    "capability_revoked": {"description": "A revoked capability reads nothing until it is rotated.", "type": "boolean"}
  },
  "if": {"properties": {"actor_kind": {"const": "human"}}},
  "then": {"properties": {"actor_agent_id": {"type": "null"}}},
  "else": {"properties": {"actor_agent_id": {"type": "string"}}}
}
