{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentilab.invalid/open-proposal/v1/receipt.schema.json",
  "title": "sentilab-open-receipt/1",
  "description": "The public record of the signed candidate row and its transitions. It carries the per-challenge pseudonym and commitments only: never an account id, a label, a message id, a room id or the client fields. Proposal-derived fields are null when the proposal did not pass schema validation, and are then never echoed. The receipt hash is the envelope hash of the signed row that carries this record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "participant_ref", "source_ref", "body_sha256", "manifest_id", "proposal_sha256",
               "geometry_sha256", "design_hash", "problem", "reference_id", "wire_track", "proposal_key", "parent",
               "terms", "revision_index", "state", "codes", "values", "sealed", "ciphertext_ref"],
  "properties": {
    "schema": {"const": "sentilab-open-receipt/1"},
    "participant_ref": {"$ref": "common.schema.json#/$defs/participant_ref"},
    "source_ref": {"$ref": "common.schema.json#/$defs/sha256"},
    "body_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "manifest_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "proposal_sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
    "geometry_sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
    "design_hash": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
    "problem": {"$ref": "common.schema.json#/$defs/id_or_null"},
    "reference_id": {"$ref": "common.schema.json#/$defs/id_or_null"},
    "wire_track": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/wire_track"}]},
    "proposal_key": {"$ref": "common.schema.json#/$defs/id_or_null"},
    "parent": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
    "terms": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/terms_id"}]},
    "revision_index": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "state": {"$ref": "common.schema.json#/$defs/public_state"},
    "codes": {"$ref": "common.schema.json#/$defs/violations"},
    "sealed": {"description": "A sealed submission's receipt is private: served by capability, never published.", "type": "boolean"},
    "ciphertext_ref": {"description": "sha256 of the sealed note's decoded age file bytes, as the server returned it; null unless sealed.",
                       "$ref": "common.schema.json#/$defs/sha256_or_null"},
    "values": {
      "description": "values.geometry as the conductor writes it: lower-left corner and footprint per die, in mm.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["geometry", "units", "scenario_id"],
      "properties": {
        "geometry": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "xLL", "yLL", "w", "h", "layer"],
            "properties": {
              "id": {"type": "string", "pattern": "^tap-chiplet-(0|[1-9][0-9]?)$"},
              "xLL": {"type": "number", "minimum": -1000, "maximum": 1000},
              "yLL": {"type": "number", "minimum": -1000, "maximum": 1000},
              "w": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
              "h": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
              "layer": {"const": 0}
            }
          }
        },
        "units": {"const": "mm"},
        "scenario_id": {"const": "nominal"}
      }
    }
  }
}
