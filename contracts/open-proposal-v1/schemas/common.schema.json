{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentilab.invalid/open-proposal/v1/common.schema.json",
  "title": "Open-proposal contract v1: shared definitions",
  "description": "Every string is a const, an enum or a pattern over a safe charset. The only participant free text anywhere is the moderated team name (DESIGN rev 3 sections 3.9 and 5.1). Integers mean JSON integer literals. UNKNOWN is a value, never a default: no bound, measurement or comparison defaults to zero (sections 4.1 and 4.7).",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha256_or_null": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "salt": {"description": "32 random hex characters, so the canonical hash of the object cannot be guessed (section 5.1).",
             "type": "string", "pattern": "^[0-9a-f]{32}$"},
    "key": {"description": "A logical key (proposal_key, request_key): sentilab_core/capabilities.py:160.",
            "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "key_or_null": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "agent_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
    "terms_version": {"description": "A terms version id carries the SHA-256 of the terms text (section 5.6).",
                      "type": "string", "pattern": "^sentilab-open-terms/[1-9][0-9]{0,5}@[0-9a-f]{64}$"},
    "visibility": {"description": "The explicit publication choice (section 5.1). private must travel sealed (section 3.7).",
                   "enum": ["public", "private"]},
    "units": {"const": "um"},
    "anchor": {"const": "die-centre"},
    "dies": {
      "description": "One entry per die, in catalogue order (section 5.1). Integer centres in micrometres from the frame's lower-left corner; rot_deg 0 or 90 (section 4.3). The frame bound and each die's allowed rotations come from the manifest and are checked by the validator.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["die", "x_um", "y_um", "rot_deg"],
        "properties": {
          "die": {"type": "integer", "minimum": 0, "maximum": 31},
          "x_um": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "y_um": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "rot_deg": {"enum": [0, 90]}
        }
      }
    },
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "utc_or_null": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "actor_kind": {"description": "Exactly what Senti stamped on the row (section 3.5); never a label.",
                   "enum": ["agent", "human"]},
    "lifecycle_state": {"enum": ["rejected", "queued", "held", "evaluating", "evaluated", "failed", "replaying",
                                 "reproduced", "not_reproduced", "cross_checked", "cancelled", "expired"]},
    "participant_ref": {"description": "HMAC-SHA256(k_challenge, account_id), per challenge (section 3.9).",
                        "type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"description": "open-<manifest_id 8 hex>-<32 hex of sha256(JCS({schema sentilab-open-run/1, manifest_id, participant_ref, proposal_sha256}))>: one run per account and proposal (section 7.4, as repaired in review).",
               "type": "string", "pattern": "^open-[0-9a-f]{8}-[0-9a-f]{32}$"},
    "transport_key": {"description": "so1- and 48 hex characters (section 3.4).",
                      "type": "string", "pattern": "^so1-[0-9a-f]{48}$"},
    "age_recipient": {"type": "string", "pattern": "^age1[02-9ac-hj-np-z]{58}$"},
    "key_version": {"type": "integer", "minimum": 1, "maximum": 999999},
    "label_state": {"description": "SLAB-053's temperature label states, mirrored (labels.json).",
                    "enum": ["withdrawn", "unvalidated", "illustrative", "accepted"]},
    "evaluator": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:=-]{0,319}$"},
    "unknown": {"const": "UNKNOWN"},
    "number_or_unknown": {"anyOf": [{"type": "number", "minimum": -10000000, "maximum": 10000000},
                                    {"const": "UNKNOWN"}]},
    "nonnegative_or_unknown": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 10000000},
                                         {"const": "UNKNOWN"}]},
    "r_key": {"description": "A q_r key: \"0\", or r with exactly two decimals (section 10's \"0.10\", \"0.25\").",
              "type": "string", "pattern": "^(0|[0-9]{1,2}\\.[0-9]{2})$"},
    "q_r": {"description": "q_r = W(c) - (1 + r) W(R) (section 4.6), keyed by r: 0, the policy tolerance r and every tradeoff budget.",
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16,
            "propertyNames": {"$ref": "#/$defs/r_key"},
            "additionalProperties": {"$ref": "#/$defs/number_or_unknown"}},
    "claim_label": {"description": "The seven claim labels, in display order (sections 4.8 and 4.11).",
                    "enum": ["declared temperature target", "strict-wire thermal tolerance",
                             "r-relaxed-wire thermal tolerance", "strict thermal improvement",
                             "strict wire improvement", "wire improvement with allowed thermal degradation",
                             "robust dominance over R"]},
    "evidence_mode": {"enum": ["bounded", "passes the listed sensitivity cases"]},
    "reason_code": {"enum": [
      "oversize", "not_utf8", "edited_before_ingest", "unattributable", "private_requires_sealed", "unsealable",
      "transport_key_mismatch",
      "malformed_json", "duplicate_key", "nonfinite_number", "too_deep", "unknown_field", "schema_invalid",
      "unknown_manifest", "manifest_mismatch", "manifest_closed", "not_open_yet", "terms_not_accepted",
      "die_count", "die_order", "out_of_frame", "rotation_not_allowed", "lattice", "margin", "halo_overlap",
      "min_spacing", "keepout", "geometry_hash_mismatch",
      "idempotency_conflict", "unknown_parent", "unknown_proposal",
      "participant_suspended", "participant_paused", "participant_removed", "rate_limited", "queue_full",
      "budget_exhausted",
      "timeout", "stopped", "oracle_error", "grant_expired", "interrupted", "binding_mismatch", "router_timeout",
      "check_unfinished",
      "reproduction_mismatch", "fresh_process_required", "reproduction_failed"]},
    "violation": {
      "description": "One reason code with only its declared fields (reason-codes.json): never submitted text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"$ref": "#/$defs/reason_code"},
        "path": {"type": "string", "maxLength": 256, "pattern": "^(/[A-Za-z0-9_]{1,64})*$"},
        "keyword": {"type": "string", "pattern": "^[A-Za-z]{1,32}$"},
        "dies": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
                 "items": {"type": "integer", "minimum": 0, "maximum": 31}},
        "amount_um": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "retry_after": {"$ref": "#/$defs/utc"},
        "limit": {"description": "Which of a check's separate limits ended it (section 6.2).",
                  "enum": ["solver_time_limit_s", "check_wall_s", "cpu_reserve_s"]}
      }
    },
    "violations": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/violation"}}
  }
}
