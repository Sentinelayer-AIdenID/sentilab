{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentilab.invalid/open-proposal/v1/cursor.schema.json",
  "title": "sentilab-open-cursor/1",
  "description": "The intake's position in one room, persisted only after the reply it names has been durably processed into the journal entry it names. Replies have no sequence of their own: the position is (created_at, action_id), compared numerically on created_at, then on the full action id. Restricted: it names a room.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "room", "after", "journal_seq", "journal_sha256"],
  "properties": {
    "schema": {"const": "sentilab-open-cursor/1"},
    "room": {"$ref": "common.schema.json#/$defs/uuid"},
    "after": {"type": ["object", "null"], "additionalProperties": false, "required": ["created_at", "action_id"],
              "properties": {"created_at": {"$ref": "common.schema.json#/$defs/senti_time"},
                             "action_id": {"$ref": "common.schema.json#/$defs/uuid"}}},
    "journal_seq": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "journal_sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"}
  },
  "if": {"properties": {"after": {"type": "null"}}},
  "then": {"properties": {"journal_seq": {"const": 0}, "journal_sha256": {"type": "null"}}},
  "else": {"properties": {"journal_seq": {"minimum": 1}, "journal_sha256": {"type": "string"}}}
}
