{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentilab.invalid/open-proposal/v1/reason-codes.schema.json",
  "title": "sentilab-open-reason-codes/1",
  "description": "reason-codes.json: the fixed vocabulary in its canonical order, each code with exactly the extra fields it carries, and the rule ids a record_inconsistent, ref_mismatch or label_mismatch names.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "groups", "rules"],
  "properties": {
    "schema": {"const": "sentilab-open-reason-codes/1"},
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "codes"],
        "properties": {
          "group": {"$ref": "common.schema.json#/$defs/id"},
          "codes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "fields"],
              "properties": {
                "code": {"$ref": "common.schema.json#/$defs/reason_code"},
                "fields": {"type": "array", "maxItems": 4, "uniqueItems": true,
                           "items": {"enum": ["path", "keyword", "dies", "amount_um", "size_bytes", "count",
                                              "retry_after", "rule"]}}
              }
            }
          }
        }
      }
    },
    "rules": {"type": "array", "maxItems": 128, "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z_]{1,32}\\.[a-z_]{1,32}$"}}
  }
}
