{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentilab.invalid/open-proposal/v1/results.schema.json",
  "title": "sentilab-open-results/1",
  "description": "GET /api/open/v1/results?m=<manifest_id>: the comparison rows of one manifest. Rows never mix manifests or engines. Under a draft manifest nothing is scored: no comparison, no claim and no control result. Public: pseudonym and optional moderated team name only; hidden rows keep their reason and are never deleted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest_id", "manifest_status", "rows"],
  "properties": {
    "schema": {"const": "sentilab-open-results/1"},
    "manifest_id": {"$ref": "common.schema.json#/$defs/sha256"},
    "manifest_status": {"enum": ["draft", "frozen"]},
    "rows": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/row"}}
  },
  "if": {"properties": {"manifest_status": {"const": "draft"}}},
  "then": {"properties": {"rows": {"items": {"properties": {"comparison": {"type": "null"},
                                                              "claims": {"maxItems": 0},
                                                              "control": {"type": "null"}}}}}},
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "participant_ref", "team_name", "proposal_sha256", "geometry_sha256", "receipt_hash",
                   "legal", "state", "hidden", "hidden_reason", "sealed", "temperature", "wire", "paper",
                   "comparison", "sensitivity", "claims", "diagnostics", "control"],
      "properties": {
        "kind": {"enum": ["reference-raw", "reference-variant", "paper", "sentilab", "outside", "control"]},
        "id": {"$ref": "common.schema.json#/$defs/id_or_null"},
        "participant_ref": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/participant_ref"}]},
        "team_name": {"$ref": "common.schema.json#/$defs/team_name"},
        "proposal_sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
        "geometry_sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
        "receipt_hash": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
        "legal": {"type": ["boolean", "null"]},
        "state": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/public_state"}]},
        "hidden": {"type": "boolean"},
        "hidden_reason": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/visibility_reason"}]},
        "sealed": {"type": "boolean"},
        "temperature": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/temperature"}]},
        "wire": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/wire"}]},
        "paper": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/paper"}]},
        "comparison": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/comparison"}]},
        "sensitivity": {"type": "array", "maxItems": 64,
                        "items": {"$ref": "common.schema.json#/$defs/case_observation"}},
        "claims": {"type": "array", "maxItems": 32, "items": {"$ref": "common.schema.json#/$defs/claim"}},
        "diagnostics": {"type": "array", "maxItems": 16, "items": {"$ref": "common.schema.json#/$defs/diagnostic"}},
        "control": {"type": ["object", "null"], "additionalProperties": false, "required": ["id", "result"],
                    "properties": {"id": {"$ref": "common.schema.json#/$defs/id"},
                                   "result": {"enum": ["control_match", "control_mismatch", "incomplete"]}}}
      },
      "allOf": [
        {"if": {"properties": {"hidden": {"const": true}}},
         "then": {"properties": {"hidden_reason": {"type": "string"}}},
         "else": {"properties": {"hidden_reason": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "outside"}}},
         "then": {"properties": {"participant_ref": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                                 "proposal_sha256": {"type": "string"}, "receipt_hash": {"type": "string"},
                                 "state": {"type": "string"}, "paper": {"type": "null"},
                                 "control": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "sentilab"}}},
         "then": {"properties": {"participant_ref": {"const": "sentilab"}, "team_name": {"type": "null"},
                                 "proposal_sha256": {"type": "string"}, "receipt_hash": {"type": "string"},
                                 "state": {"type": "string"}, "paper": {"type": "null"},
                                 "control": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"enum": ["reference-raw", "reference-variant"]}}},
         "then": {"properties": {"id": {"type": "string"}, "participant_ref": {"type": "null"},
                                 "team_name": {"type": "null"}, "state": {"type": "null"},
                                 "legal": {"type": "boolean"}, "paper": {"type": "null"},
                                 "control": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "paper"}}},
         "then": {"properties": {"paper": {"type": "object"}, "participant_ref": {"type": "null"},
                                 "team_name": {"type": "null"}, "state": {"type": "null"},
                                 "temperature": {"type": "null"}, "wire": {"type": "null"},
                                 "comparison": {"type": "null"}, "sensitivity": {"maxItems": 0},
                                 "claims": {"maxItems": 0}, "control": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "control"}}},
         "then": {"properties": {"id": {"type": "string"}, "control": {"type": "object"},
                                 "participant_ref": {"type": "null"}, "team_name": {"type": "null"},
                                 "paper": {"type": "null"}}}}
      ]
    }
  }
}
