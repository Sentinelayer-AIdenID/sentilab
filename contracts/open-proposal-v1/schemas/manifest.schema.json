{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentilab.invalid/open-proposal/v1/manifest.schema.json",
  "title": "sentilab-open-manifest/1",
  "description": "One versioned challenge manifest per problem: the only source of the math. manifest_id = sha256(JCS(manifest)). Published once and never edited; any change is a new version. A draft may leave pins null and carries provisional thresholds; a frozen manifest has every pin filled and every section frozen, and only a frozen manifest can be scored. Operational limits (rates, queue, budgets) are not here: they live in the limits config so they can change without re-versioning the math. Submission threads are not here either: they live in current.json, because a root message carries the manifest id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "challenge", "problem", "terms", "fixture", "dies", "netlist", "legality",
               "reference", "temperature", "wire", "thresholds", "wire_tracks", "sensitivity",
               "discrimination_control", "example", "window", "refs", "sealing"],
  "properties": {
    "schema": {"const": "sentilab-open-manifest/1"},
    "version": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "status": {"enum": ["draft", "frozen"]},
    "challenge": {"$ref": "common.schema.json#/$defs/id"},
    "problem": {"$ref": "common.schema.json#/$defs/id"},
    "terms": {
      "description": "The submission terms every proposal must name: evaluation, evidence and display only; no training permission.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "permits", "training"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/terms_id"},
        "permits": {"const": ["evaluation", "evidence", "display"]},
        "training": {"const": false}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "config", "config_sha256", "frame_um", "ambient_c", "link_type"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "config": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]{0,199}$"},
        "config_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "frame_um": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "ambient_c": {"type": "number", "minimum": -273.15, "maximum": 1000},
        "link_type": {"$ref": "common.schema.json#/$defs/id"}
      }
    },
    "dies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["die", "name", "w_um", "h_um", "power_w", "halo_um", "rot_deg"],
        "properties": {
          "die": {"type": "integer", "minimum": 0, "maximum": 31},
          "name": {"$ref": "common.schema.json#/$defs/id"},
          "w_um": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "h_um": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "power_w": {"type": "number", "minimum": 0, "maximum": 100000},
          "halo_um": {"type": "integer", "minimum": 0, "maximum": 100000},
          "rot_deg": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
                      "items": {"type": "integer", "enum": [0, 90]}}
        }
      }
    },
    "netlist": {
      "description": "Square, die order, zero diagonal: connection counts between dies, each declared connection counted once.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "array", "minItems": 1, "maxItems": 32,
                "items": {"type": "integer", "minimum": 0, "maximum": 1000000}}
    },
    "legality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "anchor", "origin", "lattice_um", "lattice_basis", "margin_um", "min_die_gap_um",
                   "rotation"],
      "properties": {
        "units": {"const": "um"},
        "anchor": {"const": "die-centre"},
        "origin": {"const": "frame lower-left"},
        "lattice_um": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "lattice_basis": {"description": "The submission lattice is an engineering benchmark choice, not a physical rule or the reference's uncertainty.",
                          "const": "engineering_benchmark"},
        "margin_um": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "min_die_gap_um": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "rotation": {"enum": ["catalog", "per_die_90"]}
      }
    },
    "reference": {
      "description": "The named comparator R: the raw reconstruction, scored by the same evaluator and router in this manifest. Its centres are decoded at 1e-4 mm, so it has no integer-um geometry hash: sha256 (the reference file's bytes) pins it. legal is false for an off-lattice raw layout, which is a comparator and never an admissible entry. Paper targets are a separate, reference-only field.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "track", "verdict_layout", "coordinate_model", "legal", "t_ref", "w_ref", "paper",
                   "engineering_variant"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
        "track": {"enum": ["MATCH", "BEAT"]},
        "verdict_layout": {"const": "raw"},
        "coordinate_model": {"const": "continuous"},
        "legal": {"type": "boolean"},
        "t_ref": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/temperature"}]},
        "w_ref": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/wire"}]},
        "paper": {"$ref": "common.schema.json#/$defs/paper"},
        "engineering_variant": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["id", "grid_um", "geometry_sha256", "design_hash", "legal"],
          "properties": {
            "id": {"description": "<reference id>-snap<grid in mm, point as p>: the id binds the snap grid.",
                   "$ref": "common.schema.json#/$defs/id"},
            "grid_um": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "geometry_sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
            "design_hash": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
            "legal": {"type": "boolean"}
          }
        }
      }
    },
    "temperature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statistic", "grid", "grid_map_mode", "evaluator"],
      "properties": {
        "statistic": {"const": "chiplet-centre-max"},
        "grid": {"type": "integer", "minimum": 1, "maximum": 4096},
        "grid_map_mode": {"const": "center"},
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "upstream", "binary_sha256", "gate_zero_record_sha256", "identity"],
          "properties": {
            "kind": {"enum": ["hotspot6"]},
            "upstream": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "binary_sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
            "gate_zero_record_sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
            "identity": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/identity"}]}
          }
        }
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["judged", "proxy", "router_sha256", "time_limit_s", "evaluator"],
      "properties": {
        "judged": {"const": "routed"},
        "proxy": {"const": "diagnostic"},
        "router_sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
        "time_limit_s": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 3600},
        "evaluator": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/identity"}]}
      }
    },
    "thresholds": {
      "description": "Policy parameters, not uncertainty estimates. Provisional until frozen; scoring needs a frozen manifest.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "D_k", "B_T_k", "B_W", "scenario_target_c", "tradeoff_budgets"],
      "properties": {
        "status": {"enum": ["provisional", "frozen"]},
        "D_k": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "B_T_k": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 100},
        "B_W": {"type": ["object", "null"], "additionalProperties": false,
                "required": ["fraction", "of_reference_wire_mm"],
                "properties": {"fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                               "of_reference_wire_mm": {"type": ["number", "null"], "exclusiveMinimum": 0,
                                                        "maximum": 10000000}}},
        "scenario_target_c": {"type": ["number", "null"], "minimum": -273.15, "maximum": 10000},
        "tradeoff_budgets": {"type": "array", "maxItems": 8, "uniqueItems": true,
                             "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 10}}
      }
    },
    "wire_tracks": {
      "description": "Declarable tracks. strict: W <= W_ref (factor exactly 1). relaxed: W <= factor x W_ref, labelled RELAXED.",
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "factor"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/wire_track"},
          "factor": {"type": "number", "minimum": 1, "maximum": 11}
        },
        "if": {"properties": {"id": {"const": "strict"}}},
        "then": {"properties": {"factor": {"const": 1}}},
        "else": {"properties": {"factor": {"exclusiveMinimum": 1}}}
      }
    },
    "sensitivity": {
      "description": "A finite, predeclared list of sensitivity cases. A claim can only pass the listed cases; it is not a bound.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cases"],
      "properties": {
        "status": {"enum": ["provisional", "frozen"]},
        "cases": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "applies_to", "grid", "die", "dx_um", "dy_um"],
            "properties": {
              "id": {"$ref": "common.schema.json#/$defs/id"},
              "kind": {"enum": ["replay", "mesh", "position"]},
              "applies_to": {"enum": ["candidate", "reference", "both"]},
              "grid": {"type": ["integer", "null"], "minimum": 1, "maximum": 4096},
              "die": {"type": ["integer", "null"], "minimum": 0, "maximum": 31},
              "dx_um": {"type": ["integer", "null"], "minimum": -100000, "maximum": 100000},
              "dy_um": {"type": ["integer", "null"], "minimum": -100000, "maximum": 100000}
            },
            "allOf": [
              {"if": {"properties": {"kind": {"const": "mesh"}}},
               "then": {"properties": {"grid": {"type": "integer"}, "die": {"type": "null"},
                                       "dx_um": {"type": "null"}, "dy_um": {"type": "null"}}}},
              {"if": {"properties": {"kind": {"const": "position"}}},
               "then": {"properties": {"grid": {"type": "null"}, "die": {"type": "integer"},
                                       "dx_um": {"type": "integer"}, "dy_um": {"type": "integer"}}}},
              {"if": {"properties": {"kind": {"const": "replay"}}},
               "then": {"properties": {"grid": {"type": "null"}, "die": {"type": "null"},
                                       "dx_um": {"type": "null"}, "dy_um": {"type": "null"}}}}
            ]
          }
        }
      }
    },
    "discrimination_control": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_sha256", "expected"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "source_sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"},
          "expected": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "r", "outcome"],
              "properties": {
                "type": {"$ref": "common.schema.json#/$defs/claim/properties/type"},
                "r": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 10},
                "outcome": {"enum": ["passes_listed_cases", "fails_listed_cases"]}
              }
            }
          }
        }
      }
    },
    "example": {
      "description": "Invented numbers for the brief's worked example; their evaluator is the illustrative fixture identity.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["temperature", "wire"],
      "properties": {
        "temperature": {"$ref": "common.schema.json#/$defs/temperature"},
        "wire": {"$ref": "common.schema.json#/$defs/wire"}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opens_at", "closes_at"],
      "properties": {
        "opens_at": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/utc"}]},
        "closes_at": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/utc"}]}
      }
    },
    "sealing": {
      "description": "Sealed (private) proposals and checks: age v1 binary files to this X25519 recipient, bound to this manifest. null: not offered. A key rotates only by a new manifest version; not_after ends this key's acceptance.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["format", "recipient", "key_version", "rotation"],
      "properties": {
        "format": {"const": "age-encryption.org/v1"},
        "recipient": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/age_recipient"}]},
        "key_version": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000000},
        "rotation": {"type": "object", "additionalProperties": false, "required": ["policy", "not_after"],
                     "properties": {"policy": {"const": "new_manifest_version"},
                                    "not_after": {"anyOf": [{"type": "null"},
                                                            {"$ref": "common.schema.json#/$defs/utc"}]}}}
      }
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant", "claim_rules", "checker_sha256"],
      "properties": {
        "grant": {"$ref": "common.schema.json#/$defs/id_or_null"},
        "claim_rules": {"$ref": "common.schema.json#/$defs/id_or_null"},
        "checker_sha256": {"$ref": "common.schema.json#/$defs/sha256_or_null"}
      }
    }
  }
}
