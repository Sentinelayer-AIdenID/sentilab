{
  // sentilab.aidenid.com front door. Deploy: npx wrangler deploy (from web/). API_ORIGIN is the sentilab-api
  // Container App URL; it is not a secret. ORIGIN_TOKEN is a Worker secret (wrangler secret put ORIGIN_TOKEN).
  "name": "sentilab-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "account_id": "a2324d194def16dd3617d1f362c21893",
  // run_worker_first: true, so static assets go through the Worker too and get its Content-Security-Policy header.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "sentilab.aidenid.com", "custom_domain": true }],
  // INGEST_TOKEN is a Worker secret, configured by the operator; never a plain var.
  "services": [{ "binding": "COLLECTOR", "service": "aidenid-aquarium" }],
  // Keep observation off until the aquarium accepts and retains SentiLab site/path attribution (EDGE.md).
  // DOOR_DECLARATIONS: visitors' opt-in declarations (AGENT-DOOR Amendment 4: POST /agents/declare and the opt-in on a
  // pass's page). Off ships, in both environments: no declare route (404), no page mentions declaring, nothing reaches
  // the intake's declaration fields; anything but exactly "on" is off. It stays off until warden explicitly authorizes
  // turning it on. That needs two things first, and comes after the production freeze for the talk: (1) the operator's
  // hide is confirmed on both public feeds on every serving revision; (2) one pass or one network prefix can be stopped
  // from declaring.
  "vars": { "API_ORIGIN": "https://sentilab-api.graysea-7ff72f94.eastus2.azurecontainerapps.io", "AQUARIUM_POST": "off",
    "DOOR_DECLARATIONS": "off",
    // operator stop for one pass or prefix; edit and redeploy, or use wrangler secret/var at deploy
    "DOOR_DECLARE_DENY_IDS": "", "DOOR_DECLARE_DENY_PREFIXES": "" },
  // The agent door (src/door/door.js). DOOR_TOKEN_KEY is a Worker secret (wrangler secret put DOOR_TOKEN_KEY, at least
  // 32 characters, its own per environment); without it the door stays closed. The terms a submission accepts come
  // from the intake's board (the signed manifest's accepted versions). Rate limits per token (nonce) and per client IP
  // prefix on its write route, per prefix on minting and on the routes that call the API; without these bindings each
  // falls back to an in-memory window. DOOR_HERE_LIMITER limits the lab pages' heartbeat (POST /api/open/v1/door/here)
  // per client IP prefix and has no fallback: without it the heartbeat is refused (AGENT-DOOR Amendment 4).
  "ratelimits": [
    { "name": "DOOR_NONCE_LIMITER", "namespace_id": "2026110101", "simple": { "limit": 10, "period": 60 } },
    { "name": "DOOR_IP_LIMITER", "namespace_id": "2026110102", "simple": { "limit": 60, "period": 60 } },
    { "name": "DOOR_READ_LIMITER", "namespace_id": "2026110103", "simple": { "limit": 300, "period": 60 } },
    { "name": "DOOR_MINT_LIMITER", "namespace_id": "2026110104", "simple": { "limit": 120, "period": 60 } },
    { "name": "DOOR_HERE_LIMITER", "namespace_id": "2026110105", "simple": { "limit": 300, "period": 60 } }
  ],
  // Invocation logs record each request's URL, and the door's links carry the scoped purpose token as ?t=, so they
  // stay off; console logs (the door writes none with a token) are kept.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "env": {
    // npx wrangler deploy --env staging: the Worker sentilab-web-staging at staging.sentilab.aidenid.com, with its own
    // secrets (DOOR_TOKEN_KEY, ORIGIN_TOKEN) and its own rate-limit namespaces. There is no staging API yet, and staging
    // must never reach the production API, so its API_ORIGIN is "none": its /api answers 503, the door's board reads
    // "unavailable" and a submission is refused before anything is sent. Set a staging API origin here when one exists.
    "staging": {
      "name": "sentilab-web-staging",
      "routes": [{ "pattern": "staging.sentilab.aidenid.com", "custom_domain": true }],
      "services": [{ "binding": "COLLECTOR", "service": "aidenid-aquarium" }],
      // DOOR_DECLARATIONS off, as in production, until warden explicitly authorizes turning it on (see the top).
      "vars": { "API_ORIGIN": "none", "AQUARIUM_POST": "off", "DOOR_DECLARATIONS": "off",
        // operator stop for one pass or prefix; edit and redeploy, or use wrangler secret/var at deploy
        "DOOR_DECLARE_DENY_IDS": "", "DOOR_DECLARE_DENY_PREFIXES": "" },
      "ratelimits": [
        { "name": "DOOR_NONCE_LIMITER", "namespace_id": "2026110111", "simple": { "limit": 10, "period": 60 } },
        { "name": "DOOR_IP_LIMITER", "namespace_id": "2026110112", "simple": { "limit": 60, "period": 60 } },
        { "name": "DOOR_READ_LIMITER", "namespace_id": "2026110113", "simple": { "limit": 300, "period": 60 } },
        { "name": "DOOR_MINT_LIMITER", "namespace_id": "2026110114", "simple": { "limit": 120, "period": 60 } },
        { "name": "DOOR_HERE_LIMITER", "namespace_id": "2026110115", "simple": { "limit": 300, "period": 60 } }
      ]
    }
  }
}
