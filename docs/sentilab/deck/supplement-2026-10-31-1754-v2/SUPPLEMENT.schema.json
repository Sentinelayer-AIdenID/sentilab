{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SentiLab deck factual supplement v1",
  "description": "An additive typed format. All quantitative leaves are safe integers, boolean or null. Fixed decimals mean whole + fraction / 10^places; display prose retains scope. Local validator also enforces cutoff and source-bound factual constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "asOf",
    "packagedAt",
    "title",
    "timePolicy",
    "priorPacket",
    "renderer",
    "items"
  ],
  "properties": {
    "format": {
      "const": "sentilab-deck-facts/1"
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T",
      "maxLength": 40
    },
    "packagedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T",
      "maxLength": 40
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1800
    },
    "timePolicy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1800
    },
    "priorPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "manifestSha256",
        "factualCutoff",
        "fileCount",
        "baselineFiles"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "factualCutoff": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T",
          "maxLength": 40
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "baselineFiles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibleWithLegacySchema",
        "integrationAccepted"
      ],
      "properties": {
        "compatibleWithLegacySchema": {
          "type": "boolean"
        },
        "integrationAccepted": {
          "type": "boolean"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "value",
        "unit"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 90
        },
        "kind": {
          "enum": [
            "integer",
            "boolean",
            "unknown",
            "fixed_decimal"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "whole",
                "fraction",
                "places"
              ],
              "properties": {
                "whole": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "fraction": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "places": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 15
                }
              }
            }
          ]
        },
        "unit": {
          "enum": [
            "count",
            "boolean",
            "seconds",
            "cpu_seconds",
            "bytes",
            "basis_points",
            "http_status",
            "error",
            "millimetres",
            "usd"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "value": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "fixed_decimal"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "whole",
                "fraction",
                "places"
              ],
              "properties": {
                "whole": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "fraction": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "places": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 15
                }
              }
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claimStatus",
        "evidenceClass",
        "asOf",
        "sourceAt",
        "observedAt",
        "title",
        "display",
        "qualifications",
        "facts",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "maxLength": 64
        },
        "claimStatus": {
          "enum": [
            "preserved",
            "peer_reported",
            "retained_author_results",
            "observed",
            "bounded_runtime_verified",
            "merged_source_verified",
            "repair_pending",
            "directed_pending",
            "private_content_delivered",
            "design_accepted",
            "source_accepted",
            "proposed_not_released",
            "closed_historical",
            "retained_inconclusive",
            "open",
            "unknown"
          ]
        },
        "evidenceClass": {
          "enum": [
            "accepted_content",
            "peer_model_report",
            "retained_result_review",
            "http_observation",
            "merge_binding",
            "runtime_accounting",
            "finite_source_review",
            "room_readback",
            "human_direction",
            "publication_receipt",
            "design_review",
            "source_carry",
            "proposed_protocol",
            "retained_runtime",
            "historical_record",
            "checkpoint",
            "integrity_manifest",
            "peer_model_source",
            "static_review",
            "retained_author_results",
            "review_erratum",
            "descriptive_content"
          ]
        },
        "asOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T",
          "maxLength": 40
        },
        "sourceAt": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T",
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1800
        },
        "display": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1800
        },
        "qualifications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1800
          }
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18,
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256",
              "evidenceClass"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "evidenceClass": {
                "enum": [
                  "accepted_content",
                  "peer_model_report",
                  "retained_result_review",
                  "http_observation",
                  "merge_binding",
                  "runtime_accounting",
                  "finite_source_review",
                  "room_readback",
                  "human_direction",
                  "publication_receipt",
                  "design_review",
                  "source_carry",
                  "proposed_protocol",
                  "retained_runtime",
                  "historical_record",
                  "checkpoint",
                  "integrity_manifest",
                  "peer_model_source",
                  "static_review",
                  "retained_author_results",
                  "review_erratum",
                  "descriptive_content"
                ]
              }
            }
          }
        }
      }
    }
  }
}
