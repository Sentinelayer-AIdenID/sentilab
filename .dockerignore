web/
!web/public/trust-pins.json
# The signed manifest's terms texts: the door's API serves them (app/door/terms.py DEFAULT_DIR).
!web/public/sentilab/open/terms/*.md
# chiplet.render calls the shared browser model through Node.
!web/public/sentilab/lab-model.mjs
!web/public/sentilab/evidence-projection.mjs
# app/test_door_build_label.py checks that the page tests' fixture is the door API's own output.
!web/test/door-api-build-label.json
# app/test_door_a4_fixtures.py holds the A4 fixtures and the Worker's bundled notice to the API's own code.
!web/test/fixtures/door-a4/*.json
!web/src/door/declare.js
# app/test_door_declaration_u16.py regenerates the Worker's Unicode 16 tables and the API's verdict fixture.
!web/src/door/unicode16.js
!web/test/make_declare_unicode.py
# app/test_door_lab.py checks that the Worker's registry enums are the bundled registry's (scripts/door_registry.py).
!web/src/door/registry-enums.js
deck/
**/*.pem
**/*.key
